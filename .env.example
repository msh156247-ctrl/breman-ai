# Local development defaults
BREMEN_ENV=development
BREMEN_AUTH_JWT_ONLY=false
BREMEN_JWT_SECRET=replace-with-at-least-32-random-characters
BREMEN_KEY_ENCRYPTION_SECRET=replace-with-at-least-32-random-characters
BREMEN_ADMIN_TOKEN=replace-with-at-least-24-random-characters

# Optional JWT claims enforced when configured
# BREMEN_JWT_ISSUER=https://auth.example.com/
# BREMEN_JWT_AUDIENCE=bremen-api

# Decision Log retention
BREMEN_DECISION_LOG_MAX_BYTES=8388608
BREMEN_DECISION_LOG_ARCHIVE_COUNT=5

# Production requires all three secrets above and JWT-only mode.
# BREMEN_ENV=production
# BREMEN_AUTH_JWT_ONLY=true
